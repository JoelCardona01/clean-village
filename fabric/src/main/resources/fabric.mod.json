    "main": ["dev.spotless.fabric.SpotlessFabric"]
  },
  "mixins": ["spotless.mixins.json"],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  }
